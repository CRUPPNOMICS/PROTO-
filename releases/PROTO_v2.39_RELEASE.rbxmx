function ENT.warnBanner()
	local f = Instance.new("Frame")
	f.Name = "DIMWarn"
	f.BackgroundColor3 = Color3.fromRGB(90, 60, 20)
	f.BorderSizePixel = 0
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
