		cube = { { "p", { 6, 10, 14, 5, 22, 10, 22, 20, 14, 25, 6, 20, 6, 10 } }, { "p", { 6, 10, 14, 15, 22, 10 } }, { "l", 14, 15, 14, 25 } },
		iso = { { "p", { 6, 10, 14, 5, 22, 10, 22, 20, 14, 25, 6, 20, 6, 10 }, C.B }, { "p", { 6, 10, 14, 15, 22, 10 }, C.B }, { "l", 14, 15, 14, 25, C.B } },
