local CHS = game:GetService("ChangeHistoryService")
local CoreGui = game:GetService("CoreGui")
local Selection = game:GetService("Selection")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local AssetService = game:GetService("AssetService")
local GeometryService = game:GetService("GeometryService")

local V2, V3 = Vector2.new, Vector3.new
local PI = math.pi
local TERRAIN = workspace.Terrain

local COL = {
	bg = Color3.fromRGB(34, 34, 40), btn = Color3.fromRGB(62, 62, 72), on = Color3.fromRGB(0, 120, 215),
	go = Color3.fromRGB(50, 150, 80), warn = Color3.fromRGB(180, 70, 60), head = Color3.fromRGB(120, 190, 255),
	text = Color3.new(1, 1, 1), grey = Color3.fromRGB(160, 160, 170),
	shape = Color3.fromRGB(0, 255, 60), picked = Color3.fromRGB(0, 255, 60), sel = Color3.fromRGB(255, 210, 40), guide = Color3.fromRGB(255, 225, 0),
	snap = Color3.fromRGB(60, 230, 110), cursor = Color3.fromRGB(210, 210, 210), infer = Color3.fromRGB(255, 225, 0),
	axX = Color3.fromRGB(235, 70, 70), axY = Color3.fromRGB(70, 210, 90), axZ = Color3.fromRGB(70, 140, 255),
	plane = Color3.fromRGB(90, 160, 255), planeEdge = Color3.fromRGB(150, 201, 255),
	cross = Color3.fromRGB(255, 225, 0),
	ex = Color3.fromRGB(0, 170, 255), cut = Color3.fromRGB(255, 60, 60), arrow = Color3.fromRGB(255, 150, 30),
}

-- ===== state =====
local active = false        -- mouse is captured by DIM
local mode = "planes"       -- "planes" (planes + sketch) or "face"
local target, planes = nil, nil
local showPlanes = true
local hoverPlane = nil
local sk = nil              -- current sketch { pl, host, shapes, sel, half, name }
local tool = "select"
local pend = {}             -- clicked points waiting for the next click
local ex = nil              -- extrude preview { list, D (signed depth), rec, carrier, lo, hi, c2 }
local exBallHover, exDrag = false, nil   -- DIM's own pull ball (Roblox's Handles ball shrank on thin / far boxes)
local bothWays = false      -- setting: extrude grows equally both sides of the sketch
local patAxis = "Y"
local facePart, faceId, dragStart, overHandle = nil, nil, nil, false
local targetConns = {}

-- forward declarations
local setStatus, refreshStatus, drawPlanes, drawSketch, drawPreview, rebuildFields
local setTool, setMode, setTarget, startSketch, exitSketch, turnOn, turnOff, view
local extrude, mirrorSel, pattern, centreOnTarget, meshTest, faceNudge, faceUnlock
local finishLine, cancelPending, undoShape, togglePlanes
