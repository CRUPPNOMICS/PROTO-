ENT.paintCol, ENT.paintMat, ENT.paintDoCol, ENT.paintDoMat = Color3.fromRGB(163, 162, 165), Enum.Material.SmoothPlastic, true, true
U.swatches = {}
for rowI, cols in ipairs({
	{ { 255, 255, 255 }, { 163, 162, 165 }, { 99, 95, 98 }, { 27, 42, 53 }, { 17, 17, 17 }, { 196, 40, 28 }, { 255, 89, 89 }, { 218, 133, 65 } },
	{ { 245, 205, 48 }, { 255, 255, 0 }, { 75, 151, 75 }, { 0, 255, 0 }, { 13, 105, 172 }, { 0, 162, 255 }, { 107, 50, 124 }, { 124, 92, 70 } },
}) do
	r = pui(mkRow())
	for _, c in ipairs(cols) do
		local col = Color3.fromRGB(c[1], c[2], c[3])
		local b = mkBtn(r, "", 30, function() ENT.paintCol = col ENT.paintRefresh() end, col)
		b.TextColor3 = (c[1] + c[2] + c[3] > 400) and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
		U.swatches[b] = col
	end
end
r = pui(mkRow())
mkLabel(r, "R,G,B", 40)
U.paintRGB = mkBox(r, "163, 162, 165", 110)
U.paintSetBtn = mkBtn(r, "Set", 40, function()
	local t = {}
	for n in string.gmatch(U.paintRGB.Text, "%d+") do table.insert(t, math.clamp(tonumber(n), 0, 255)) end
	if #t >= 3 then ENT.paintCol = Color3.fromRGB(t[1], t[2], t[3]) ENT.paintRefresh() end
end)
mkBtn(r, "Pick", 50, function() ENT.paintPicking = true ENT.paintRefresh() end)
r = pui(mkRow())
