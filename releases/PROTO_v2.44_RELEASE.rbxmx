local CHS = game:GetService("ChangeHistoryService")
local CoreGui = game:GetService("CoreGui")
local Selection = game:GetService("Selection")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local AssetService = game:GetService("AssetService")
local GeometryService = game:GetService("GeometryService")

local V2, V3 = Vector2.new, Vector3.new
local PI = math.pi
local TERRAIN = workspace.Terrain

local COL = {
	bg = Color3.fromRGB(34, 34, 40), btn = Color3.fromRGB(62, 62, 72), on = Color3.fromRGB(0, 120, 215),
	go = Color3.fromRGB(50, 150, 80), warn = Color3.fromRGB(180, 70, 60), head = Color3.fromRGB(120, 190, 255),
	text = Color3.new(1, 1, 1), grey = Color3.fromRGB(160, 160, 170),
	shape = Color3.fromRGB(0, 255, 60), picked = Color3.fromRGB(0, 255, 60), sel = Color3.fromRGB(255, 210, 40), guide = Color3.fromRGB(255, 225, 0),
	snap = Color3.fromRGB(60, 230, 110), cursor = Color3.fromRGB(210, 210, 210), infer = Color3.fromRGB(255, 225, 0),
	axX = Color3.fromRGB(235, 70, 70), axY = Color3.fromRGB(70, 210, 90), axZ = Color3.fromRGB(70, 140, 255),
	plane = Color3.fromRGB(90, 160, 255), planeEdge = Color3.fromRGB(150, 201, 255),
	cross = Color3.fromRGB(255, 225, 0),
	ex = Color3.fromRGB(0, 170, 255), cut = Color3.fromRGB(255, 60, 60), arrow = Color3.fromRGB(255, 150, 30),
}

-- ===== state =====
local active = false        -- mouse is captured by DIM
local mode = "planes"       -- "planes" (planes + sketch) or "face"
local target, planes = nil, nil
local showPlanes = true
local hoverPlane = nil
local sk = nil              -- current sketch { pl, host, shapes, sel, half, name }
local tool = "select"
local pend = {}             -- clicked points waiting for the next click
local ex = nil              -- extrude preview { list, D (signed depth), rec, carrier, lo, hi, c2 }
local exBallHover, exDrag = false, nil   -- DIM's own pull ball (Roblox's Handles ball shrank on thin / far boxes)
local bothWays = false      -- setting: extrude grows equally both sides of the sketch
local patAxis = "Y"
local facePart, faceId, dragStart, overHandle = nil, nil, nil, false
local targetConns = {}

-- forward declarations
local setStatus, refreshStatus, drawPlanes, drawSketch, drawPreview, rebuildFields
local setTool, setMode, setTarget, startSketch, exitSketch, turnOn, turnOff, view
local extrude, mirrorSel, pattern, centreOnTarget, meshTest, faceNudge, faceUnlock
local finishLine, cancelPending, undoShape, togglePlanes
local ENT = {}   -- sketch entity helpers (kept in a table: the script is at Luau's 200-local limit)
local flyTo, acceptExtrude, cancelExtrude, exRefresh
local pointInPoly

-- ===== toolbar + hotkey actions =====
local toolbar = plugin:CreateToolbar("PROTO")
local mainBtn = toolbar:CreateButton("DIM_Main", "PROTO - planes, sketch, extrude, revolve, mirror, pattern", "rbxassetid://102678489126376", "PROTO")   -- v2.39: toolbar icon (Dylan's upload)
mainBtn.ClickableWhenViewportHidden = true
local function addAction(id, text, tip, fn)
	local a = plugin:CreatePluginAction(id, text, tip, "", true)
	a.Triggered:Connect(function() fn() end)
end

-- ===== panel =====
local widget = plugin:CreateDockWidgetPluginGui("DIM_Panel",
	DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 290, 680, 250, 300))
widget.Title = "PROTO"
widget.Name = "DIM_Panel"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
widget.Enabled = false

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.fromScale(1, 1)
scroll.BackgroundColor3 = COL.bg
scroll.BorderSizePixel = 0
scroll.CanvasSize = UDim2.new()
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.ScrollBarThickness = 6
scroll.Parent = widget
local pad = Instance.new("UIPadding")
pad.PaddingLeft, pad.PaddingTop, pad.PaddingRight, pad.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 12), UDim.new(0, 12)
pad.Parent = scroll
local function vlist(parent)
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, 4)
	l.Parent = parent
end
vlist(scroll)

local order = 0
local curGroup = nil   -- the boxed section being built (mkHead starts a new one)
local function place(obj, parent)
	order += 1
	obj.LayoutOrder = order
	obj.Parent = parent or curGroup or scroll
	return obj
end
local function corner(x)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = x
end
local function mkLabel(parent, text, w, o)
	o = o or {}
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = o.bold and Enum.Font.GothamBold or Enum.Font.Gotham
	l.TextSize = o.size or 12
	l.TextColor3 = o.col or COL.text
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	if w then
		l.Size = UDim2.fromOffset(w, 24)
	else
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
	end
	return place(l, parent)
end
local function mkHead(text)
	-- each section = its own box (outline + slightly lighter background) so the groups are easy to see
	local g = Instance.new("Frame")
	g.Name = "DIMGroup"
	g.BackgroundColor3 = Color3.fromRGB(44, 44, 52)
	g.BorderSizePixel = 0
	g.Size = UDim2.new(1, 0, 0, 0)
	g.AutomaticSize = Enum.AutomaticSize.Y
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = g
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(80, 110, 150)
	st.Thickness = 1
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = g
	local p = Instance.new("UIPadding")
	p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 5), UDim.new(0, 7)
	p.Parent = g
	vlist(g)
	curGroup = nil
	place(g)
	ENT.heads = ENT.heads or {}
	ENT.heads[text] = g
	-- v1.99: the title is a drop-down button - click to fold the section away / open it (remembered next time)
	local h = Instance.new("TextButton")
	h.Name = "Head"
	h.BackgroundTransparency = 1
	h.Size = UDim2.new(1, 0, 0, 20)
	h.Font = Enum.Font.GothamBold
	h.TextSize = 13
	h.TextColor3 = COL.head
	h.TextXAlignment = Enum.TextXAlignment.Left
	h.AutoButtonColor = false
	place(h, g)
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	vlist(body)
	place(body, g)
	local key = "DIM_open_" .. text:gsub("%W", "")
	local DEFAULT_OPEN = { MODE = true, VIEW = true, SKETCH = true, EXTRUDE = true, PAINT = true }
	local open = DEFAULT_OPEN[text] == true
	pcall(function()
		local saved = plugin:GetSetting(key)
		if saved ~= nil then open = saved end
	end)
	local function show()
		body.Visible = open
		h.Text = (open and "v  " or ">  ") .. text
	end
	show()
	h.MouseButton1Click:Connect(function()
		open = not open
		show()
		pcall(function() plugin:SetSetting(key, open) end)
	end)
	curGroup = body
	return g   -- (hiding the box hides the whole section)
end
-- a smaller box inside a section (title + its own outline)
function ENT.sub(title)
	local parent = curGroup
	local g = Instance.new("Frame")
	g.Name = "DIMSub"
	g.BackgroundColor3 = Color3.fromRGB(52, 52, 62)
	g.BorderSizePixel = 0
	g.Size = UDim2.new(1, 0, 0, 0)
	g.AutomaticSize = Enum.AutomaticSize.Y
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 5)
	c.Parent = g
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(70, 90, 120)
	st.Thickness = 1
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = g
	local p = Instance.new("UIPadding")
	p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = UDim.new(0, 5), UDim.new(0, 5), UDim.new(0, 3), UDim.new(0, 5)
	p.Parent = g
	vlist(g)
	place(g)
	ENT.subParent = parent
	curGroup = g
	mkLabel(nil, title, nil, { bold = true, col = COL.grey, size = 11 })
end
function ENT.subEnd() curGroup = ENT.subParent end
local function mkRow(parent)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.Size = UDim2.new(1, 0, 0, 24)
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, 4)
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Parent = f
	return place(f, parent)
end
local function mkBtn(parent, text, w, fn, col)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w, 24)
	b.BackgroundColor3 = col or COL.btn
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.TextColor3 = COL.text
	b.Text = text
	b.AutoButtonColor = true
	corner(b)
	ENT.btnFn = ENT.btnFn or {}
	ENT.btnFn[b] = fn   -- v2.40: the top ribbon has copies of these buttons
	b.Activated:Connect(function()
		if widget.Enabled and not active and turnOn then turnOn() end
		local ok, err = pcall(fn, b)
		if not ok then warn("PROTO error: " .. tostring(err)) setStatus("Error: " .. tostring(err)) end
	end)
	return place(b, parent)
end
local function mkBox(parent, default, w)
	local t = Instance.new("TextBox")
	t.Size = UDim2.fromOffset(w, 24)
	t.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	t.BorderSizePixel = 0
	t.Font = Enum.Font.Gotham
	t.TextSize = 12
	t.TextColor3 = COL.text
	t.ClearTextOnFocus = false
	t.Text = default
	corner(t)
	return place(t, parent)
end

